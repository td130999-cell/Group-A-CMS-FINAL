# ==============================================================================
# Cấu hình môi trường cho Docker WordPress - Group A CMS
# ==============================================================================

# Cổng truy cập từ máy chủ (Host Ports)
WORDPRESS_PORT=8000
PMA_PORT=8081
DB_PORT=3307

# Thông tin cơ sở dữ liệu MariaDB/MySQL
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root_password

# Cấu hình WordPress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=false

